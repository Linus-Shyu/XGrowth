# Line endings
*.mjs text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Programming languages GitHub should show on the language bar.
# This repo is intentionally JS + Shell (+ workflow YAML) — no Python/Go/etc.
*.mjs linguist-language=JavaScript linguist-detectable=true linguist-generated=false
*.sh linguist-language=Shell linguist-detectable=true linguist-generated=false
*.yml linguist-language=YAML linguist-detectable=true
*.yaml linguist-language=YAML linguist-detectable=true
.github/scripts/** linguist-detectable=true linguist-generated=false
.github/workflows/** linguist-detectable=true

# Keep non-code artifacts out of the language bar so they don't hide Shell/YAML
*.md linguist-documentation=true
docs/** linguist-documentation=true
reports/** linguist-documentation=true
examples/** linguist-documentation=true
archive/** linguist-documentation=true
*.json linguist-documentation=true
*.jsonl linguist-documentation=true
docs/images/** linguist-vendored=true
